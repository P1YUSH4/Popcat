{
  "name": "pao-companion",
  "version": "0.1.0",
  "description": "An original desktop pixel companion (Comnyang-inspired) built with Electron + TypeScript + Canvas.",
  "main": "dist/main.js",
  "scripts": {
    "gen:sprites": "python tools/gen_companion.py",
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "dev": "node build.mjs --watch",
    "test": "node scripts/run-tests.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis portable"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.4"
  },
  "build": {
    "appId": "com.pao.companion",
    "productName": "Pao",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "package.json"],
    "asar": false,
    "win": { "target": ["nsis", "portable"], "icon": "assets/icon.png" },
    "mac": { "target": ["dmg", "zip"], "icon": "assets/icon.png", "category": "public.app-category.entertainment" },
    "linux": { "target": ["AppImage"] },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true }
  }
}
